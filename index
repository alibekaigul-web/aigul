  function genLogicTask(tier){
    const kinds = tier===1 ? ["seq","odd","analogy","order"] : (tier===2 ? ["seq","odd","analogy","order"] : ["seq","odd","analogy","order","riddle"]);
    const kind = pick(kinds);

    if(kind==="seq"){
      let start, step, terms=[];
      if(tier===1){ start=randInt(1,10); step=randInt(1,3); for(let i=0;i<4;i++) terms.push(start+step*i); }
      else if(tier===2){ start=randInt(1,20); step= pick([2,3,4,5]) * pick([1,1,2]); for(let i=0;i<4;i++) terms.push(start+step*i); }
      else{
        start=randInt(1,10);
        const s1=randInt(2,5), s2=randInt(6,9);
        terms=[start, start+s1, start+s1+s2, start+2*s1+s2];
        step = s1; // for computing 5th term with alternating pattern
      }
      let next;
      if(tier===3){ next = terms[3] + step; } else { next = terms[3] + step; }
      const distractors = new Set([next]);
      while(distractors.size<4){ distractors.add(next + pick([-3,-2,-1,1,2,3,4])); }
      const options = shuffle(Array.from(distractors)).map(String);
      return {
        kind:"logic-seq",
        prompt:"Сандар тізбегін жалғастыр: " + terms.join(", ") + ", ?",
        speakText:"Сандар тізбегін жалғастыр: " + terms.join(", "),
        render(body){
          body.appendChild(el("div",{class:"options"}, options.map(o=> optionButton(o, options))));
        },
        correctValue: String(next),
      };
    }

    if(kind==="odd"){
      const bank = ODD_ONE_OUT[tier];
      const set = pick(bank);
      return {
        kind:"logic-odd",
        prompt:"Басқалардан ерекшеленетінін тап:",
        speakText:"Басқалардан ерекшеленетін затты тап.",
        render(body){
          const wrap = el("div",{class:"options"});
          set.items.forEach((item,idx)=>{
            wrap.appendChild(optionButton(item, set.items, idx));
          });
          body.appendChild(wrap);
        },
        correctValue: set.oddIndex,
        byIndex:true,
      };
    }

    if(kind==="analogy"){
      const set = pick(ANALOGIES[tier]);
      return {
        kind:"logic-analogy",
        prompt: set.a + " — " + set.b + ". " + set.c + " — ?",
        speakText: set.a + " " + set.b + ". " + set.c + " не?",
        render(body){
          body.appendChild(el("div",{class:"options"}, set.options.map(o=>optionButton(o, set.options))));
        },
        correctValue: set.correct,
      };
    }

    if(kind==="order"){
      const count = tier===1?4:(tier===2?5:6);
      const max = tier===1?20:(tier===2?60:200);
      let nums = new Set();
      while(nums.size<count) nums.add(randInt(1,max));
      const arr = shuffle(Array.from(nums));
      const sorted = arr.slice().sort((a,b)=>a-b);
      return {
        kind:"logic-order",
        prompt:"Сандарды өсу ретімен (кішіден үлкенге қарай) бір-бірлеп бас:",
        speakText:"Сандарды кішіден үлкенге қарай ретімен бас.",
        render(body){
          const clickOrder = [];
          const wrap = el("div",{class:"options"});
          const btns = arr.map(n=>{
            const b = el("button",{class:"opt-btn", text:String(n)});
            b.addEventListener("click", function(){
              if(b.classList.contains("selected")) return;
              b.classList.add("selected");
              clickOrder.push(n);
              b.disabled = true;
            });
            wrap.appendChild(b);
            return b;
          });
          body.appendChild(wrap);
          body._getOrder = ()=> clickOrder;
        },
        customCheck(body){
          const order = body._getOrder ? body._getOrder() : [];
          return order.length===sorted.length && order.every((v,i)=>v===sorted[i]);
        },
      };
    }

    // riddle
    const r = pick(RIDDLES);
    return {
      kind:"logic-riddle",
      prompt: r.text,
      speakText: r.text,
      render(body){
        body.appendChild(el("div",{class:"options"}, r.options.map(o=>optionButton(o, r.options))));
      },
      correctValue: r.correct,
    };
  }

  function optionButton(value, all, indexOverride){
    const b = el("button",{class:"opt-btn", text: String(value)});
    b.dataset.value = indexOverride!==undefined ? String(indexOverride) : String(value);
    b.addEventListener("click", function(){
      if(state.checked) return;
      Array.from(b.parentElement.children).forEach(c=>c.classList.remove("selected"));
      b.classList.add("selected");
    });
    return b;
  }

  function genAttentionTask(tier){
    const kinds = ["search","stroop","memory","spot"];
    const kind = pick(kinds);

    if(kind==="search"){
      const size = tier===1?4:(tier===2?5:6);
      const total = size*size;
      const fa = FRUIT_ANIMALS_BY_TIER[tier];
      const targetCount = randInt(tier===1?3:5, tier===1?6:(tier===2?9:12));
      let cells = [];
      for(let i=0;i<targetCount;i++) cells.push(fa.target);
      while(cells.length<total) cells.push(pick(fa.pool));
      cells = shuffle(cells);
      const correct = targetCount;
      const distractSet = new Set([correct]);
      while(distractSet.size<4) distractSet.add(Math.max(1, correct + pick([-2,-1,1,2,3])));
      const options = shuffle(Array.from(distractSet)).map(String);
      return {
        kind:"attn-search",
        prompt:"Суретте нешеу " + fa.target + " бар? Дұрыс санды таңда.",
        speakText:"Суретте нешеу дана бар? Санын таңда.",
        render(body){
          const grid = el("div",{class:"grid"});
          grid.style.gridTemplateColumns = "repeat(" + size + ", 1fr)";
          grid.style.maxWidth = (size*46)+"px";
          cells.forEach(c=> grid.appendChild(makeCell(c)));
          body.appendChild(grid);
          body.appendChild(el("div",{class:"options"}, options.map(o=>optionButton(o, options))));
        },
        correctValue: String(correct),
      };
    }

    if(kind==="stroop"){
      const n = tier===1?2:(tier===2?3:4);
      const palette = COLORS.slice(0,n);
      const wordObj = pick(palette);
      let colorObj = pick(palette);
      if(palette.length>1){ while(colorObj.word===wordObj.word) colorObj = pick(palette); }
      const askColor = tier<3 ? true : pick([true,false]);
      return {
        kind:"attn-stroop",
        prompt: askColor
          ? "Сөз емес, әрпінің ТҮСІН таңда:"
          : "Түсіне қарамай, сөздің МАҒЫНАСЫН таңда:",
        speakText: askColor ? "Сөздің әрпінің түсін таңда." : "Сөздің мағынасын таңда, түсіне қарама.",
        render(body){
          const word = el("div",{},[]);
          word.textContent = wordObj.word;
          word.style.fontSize = "2rem";
          word.style.fontWeight = "700";
          word.style.color = colorObj.hex;
          word.style.margin = "6px 0 16px";
          body.appendChild(word);
          const wrap = el("div",{class:"options"});
          palette.forEach(p=>{
            const b = el("button",{class:"opt-btn"});
            b.textContent = p.word;
            b.style.borderColor = p.hex;
            b.dataset.value = p.word;
            b.addEventListener("click", function(){
              if(state.checked) return;
              Array.from(wrap.children).forEach(c=>c.classList.remove("selected"));
              b.classList.add("selected");
            });
            wrap.appendChild(b);
          });
          body.appendChild(wrap);
        },
        correctValue: askColor ? colorObj.word : wordObj.word,
      };
    }

    if(kind==="memory"){
      const tileCount = 6;
      const seqLen = tier===1?3:(tier===2?4:5);
      const sequence = [];
      for(let i=0;i<seqLen;i++) sequence.push(randInt(0,tileCount-1));
      return {
        kind:"attn-memory",
        prompt:"Жыпылықтаған торкөздердің ретін жатта да, солай қайталап бас.",
        speakText:"Торкөздердің жыпылықтау ретін жатта.",
        render(body){
          const grid = el("div",{class:"grid"});
          grid.style.gridTemplateColumns = "repeat(3, 1fr)";
          grid.style.maxWidth = "220px";
          const tiles = [];
          for(let i=0;i<tileCount;i++){
            const t = el("div",{class:"cell tile", text:""});
            tiles.push(t);
            grid.appendChild(t);
          }
          const status = el("div",{class:"transcript", text:"Байқа... жыпылықтап тұр"});
          body.appendChild(status);
          body.appendChild(grid);

          const userSeq = [];
          let locked = true;
          tiles.forEach((t,idx)=>{
            t.addEventListener("click", function(){
              if(locked) return;
              userSeq.push(idx);
              t.classList.add("flash");
              setTimeout(()=>t.classList.remove("flash"), 200);
            });
          });

          async function flashSeq(){
            locked = true;
            status.textContent = "Байқа... жыпылықтап тұр";
            await new Promise(r=>setTimeout(r,500));
            for(const idx of sequence){
              tiles[idx].classList.add("flash");
              await new Promise(r=>setTimeout(r,450));
              tiles[idx].classList.remove("flash");
              await new Promise(r=>setTimeout(r,180));
            }
            locked = false;
            status.textContent = "Енді өзің сол ретпен бас";
          }
          flashSeq();
          body._getUserSeq = ()=> userSeq;
        },
        customCheck(body){
          const u = body._getUserSeq ? body._getUserSeq() : [];
          return u.length===sequence.length && u.every((v,i)=>v===sequence[i]);
        },
      };
    }

    // spot the change
    const size = tier===1?3:(tier===2?4:5);
    const total = size*size;
    const fa = FRUIT_ANIMALS_BY_TIER[tier];
    let cells = [];
    for(let i=0;i<total;i++) cells.push(fa.target);
    const changeIndex = randInt(0,total-1);
    const changedTo = pick(fa.pool);
    return {
      kind:"attn-spot",
      prompt:"Алдымен суретті есте сақта, содан кейін өзгерген торкөзді тап.",
      speakText:"Суретті есте сақта, өзгерген жерді тап.",
      render(body){
        const status = el("div",{class:"transcript", text:"Есте сақта..."});
        body.appendChild(status);
        const grid = el("div",{class:"grid"});
        grid.style.gridTemplateColumns = "repeat(" + size + ", 1fr)";
        grid.style.maxWidth = (size*46)+"px";
        const before = cells.map(c=> makeCell(c));
        before.forEach(c=>grid.appendChild(c));
        body.appendChild(grid);
        let answered = false;
        setTimeout(function(){
          status.textContent = "Енді өзгерген торкөзді бас:";
          grid.innerHTML = "";
          cells.forEach((c,idx)=>{
            const shown = idx===changeIndex ? changedTo : c;
            const cell = makeCell(shown, "", function(){
              if(answered) return;
              answered = true;
              body._picked = idx;
              cell.classList.add(idx===changeIndex ? "correct" : "wrong");
              if(idx!==changeIndex) grid.children[changeIndex].classList.add("correct");
            });
            grid.appendChild(cell);
          });
        }, tier===1?2200:(tier===2?1800:1400));
      },
      customCheck(body){ return body._picked === changeIndex; },
    };
  }

  function genListeningTask(tier){
    const kinds = ["passage","beeps","recall","soundmatch"];
    const kind = pick(kinds);

    if(kind==="passage"){
      const p = pick(PASSAGES[tier]);
      return {
        kind:"listen-passage",
        prompt: p.q,
        speakText: p.text,
        transcript: p.text,
        render(body){
          const toggle = el("button",{class:"toggle-text", text:"Мәтінді көрсету"});
          const box = el("div",{class:"transcript", text:p.text});
          box.style.display = "none";
          toggle.addEventListener("click", function(){
            const on = box.style.display==="none";
            box.style.display = on?"block":"none";
            toggle.textContent = on?"Мәтінді жасыру":"Мәтінді көрсету";
          });
          body.appendChild(toggle);
          body.appendChild(box);
          body.appendChild(el("div",{class:"options"}, p.options.map(o=>optionButton(o,p.options))));
        },
        correctValue: p.correct,
      };
    }

    if(kind==="beeps"){
      const count = tier===1? randInt(2,4) : (tier===2? randInt(3,6) : randInt(5,9));
      const gap = tier===1?450:(tier===2?350:260);
      const optSet = new Set([count]);
      while(optSet.size<4) optSet.add(Math.max(1,count+pick([-2,-1,1,2])));
      const options = shuffle(Array.from(optSet)).map(String);
      return {
        kind:"listen-beeps",
        prompt:"Дыбыстық сигналдарды тыңда: нешеу сигнал естідің?",
        speakText:"",
        render(body){
          const replay = el("button",{class:"listen-btn", text:"🔊 Сигналдарды қайта ойнату"});
          replay.style.marginBottom = "12px";
          replay.addEventListener("click", ()=>playBeepSequence(count, gap));
          body.appendChild(replay);
          body.appendChild(el("div",{class:"options"}, options.map(o=>optionButton(o, options))));
          setTimeout(()=>playBeepSequence(count, gap), 350);
        },
        correctValue: String(count),
      };
    }

    if(kind==="recall"){
      const len = tier===1?3:(tier===2?4:5);
      const pool = WORD_POOLS[tier];
      const chosen = shuffle(pool).slice(0,len);
      return {
        kind:"listen-recall",
        prompt:"Сөздерді тыңда да, естіген ретімен бас.",
        speakText: chosen.join(", "),
        render(body){
          const status = el("div",{class:"transcript", text:"Сөздер оқылды. Енді есте қалған ретімен бас."});
          body.appendChild(status);
          const clickOrder = [];
          const wrap = el("div",{class:"options"});
          shuffle(chosen).forEach(w=>{
            const b = el("button",{class:"opt-btn", text:w});
            b.addEventListener("click", function(){
              if(b.disabled) return;
              b.disabled = true;
              b.classList.add("selected");
              clickOrder.push(w);
            });
            wrap.appendChild(b);
          });
          body.appendChild(wrap);
          body._getOrder = ()=>clickOrder;
          setTimeout(()=>speak(chosen.join(", ")), 300);
        },
        customCheck(body){
          const order = body._getOrder ? body._getOrder():[];
          return order.length===chosen.length && order.every((v,i)=>v===chosen[i]);
        },
      };
    }

    // sound match
    const set = pick(SOUND_SETS[tier]);
    return {
      kind:"listen-soundmatch",
      prompt:"Сөзді тыңда: осы сөзбен бірдей дыбыстан басталатын сөзді тап.",
      speakText: set.target,
      render(body){
        body.appendChild(el("div",{class:"transcript", text:"Сөз: " + set.target}));
        body.appendChild(el("div",{class:"options"}, shuffle(set.options).map(o=>optionButton(o,set.options))));
      },
      correctValue: set.correct,
    };
  }

