    feedback: document.getElementById("feedback"),
    listenBtn: document.getElementById("listenBtn"),
    badges: document.getElementById("badges"),
  };

  const KIND_LABEL = {
    logic:"Логика", attention:"Зейін", listening:"Тыңдау"
  };

  function buildGradeRow(){
    els.gradeRow.innerHTML = "";
    for(let g=1; g<=9; g++){
      const btn = el("button",{class:"grade-btn", text:String(g), "aria-current": String(g===state.grade)});
      btn.addEventListener("click", function(){ state.grade=g; buildGradeRow(); newTask(); });
      els.gradeRow.appendChild(btn);
      if(g<9){
        const line = el("div",{class:"grade-line" + (g<state.grade?" done":"")});
        els.gradeRow.appendChild(line);
      }
    }
    const tier = tierOf(state.grade);
    const label = tier===1? "1–3 сынып деңгейі — негізгі жаттығулар" : (tier===2? "4–6 сынып деңгейі — орта күрделілік" : "7–9 сынып деңгейі — жоғары күрделілік");
    els.tierLabel.textContent = label;
  }

  function selectTab(cat){
    state.category = cat;
    Array.from(els.tabs.children).forEach(t=>{
      t.setAttribute("aria-selected", String(t.dataset.cat===cat));
    });
    newTask();
  }

  Array.from(els.tabs.children).forEach(tabEl=>{
    tabEl.addEventListener("click", ()=>selectTab(tabEl.dataset.cat));
  });

  function updateBadges(){
    els.badges.innerHTML = "";
    ["logic","attention","listening"].forEach(cat=>{
      const p = progress[cat] || {correct:0,total:0};
      const b = el("div",{class:"badge"});
      b.innerHTML = KIND_LABEL[cat] + ": <b>" + p.correct + "</b>/" + p.total;
      els.badges.appendChild(b);
      const countEl = document.getElementById("count-"+cat);
      if(countEl) countEl.textContent = p.total>0 ? ("✅ " + p.correct + "/" + p.total) : "Әлі басталмады";
    });
  }

  function newTask(){
    state.checked = false;
    els.feedback.className = "feedback";
    els.feedback.textContent = "";
    els.checkBtn.disabled = false;
    els.checkBtn.textContent = "Тексеру";
    els.taskBody.innerHTML = "";

    const tier = tierOf(state.grade);
    let task;
    if(state.category==="logic") task = genLogicTask(tier);
    else if(state.category==="attention") task = genAttentionTask(tier);
    else task = genListeningTask(tier);

    state.task = task;
    els.taskKind.textContent = KIND_LABEL[state.category] + " · " + tier + "-деңгей";
    els.prompt.textContent = task.prompt;
    task.render(els.taskBody);
  }

  function checkAnswer(){
    if(state.checked) return;
    const task = state.task;
    let ok = false;

    if(task.customCheck){
      ok = task.customCheck(els.taskBody);
    } else {
      const selected = els.taskBody.querySelector(".opt-btn.selected");
      if(!selected){
        els.feedback.className = "feedback show no";
        els.feedback.textContent = "Алдымен жауапты таңда.";
        return;
      }
      const val = task.byIndex ? Number(selected.dataset.value) : selected.dataset.value;
      ok = task.byIndex ? (val === task.correctValue) : (String(val) === String(task.correctValue));
      Array.from(els.taskBody.querySelectorAll(".opt-btn")).forEach(b=>{
        const bv = task.byIndex ? Number(b.dataset.value) : b.dataset.value;
        const isCorrect = task.byIndex ? (bv===task.correctValue) : (String(bv)===String(task.correctValue));
        if(isCorrect) b.classList.add("correct");
        else if(b.classList.contains("selected")) b.classList.add("wrong");
        b.disabled = true;
      });
    }

    state.checked = true;
    els.checkBtn.disabled = true;

    const cat = state.category;
    progress[cat] = progress[cat] || {correct:0,total:0};
    progress[cat].total += 1;
    if(ok) progress[cat].correct += 1;
    saveProgress(progress);
    updateBadges();

    els.feedback.className = "feedback show " + (ok?"ok":"no");
    els.feedback.textContent = ok ? "Дұрыс! Жарайсың! 🌟" : "Дұрыс емес екен. Келесі тапсырмада жақсырақ шығады!";
  }

  els.checkBtn.addEventListener("click", checkAnswer);
  els.nextBtn.addEventListener("click", newTask);
  els.listenBtn.addEventListener("click", function(){
    if(!state.task) return;
    speak(state.task.speakText || state.task.prompt);
  });

  document.getElementById("resetBtn").addEventListener("click", function(){
    progress = { logic:{correct:0,total:0}, attention:{correct:0,total:0}, listening:{correct:0,total:0} };
    saveProgress(progress);
    updateBadges();
  });

  /* ================= Accessibility controls ================= */
  let fontScale = 1;
  document.getElementById("fontUp").addEventListener("click", function(){
    fontScale = Math.min(1.4, fontScale+0.1);
    document.documentElement.style.setProperty("--scale", fontScale);
  });
  document.getElementById("fontDown").addEventListener("click", function(){
    fontScale = Math.max(0.85, fontScale-0.1);
    document.documentElement.style.setProperty("--scale", fontScale);
  });
  const contrastBtn = document.getElementById("contrastBtn");
  contrastBtn.addEventListener("click", function(){
    const on = document.documentElement.getAttribute("data-contrast")==="high";
    if(on){ document.documentElement.removeAttribute("data-contrast"); contrastBtn.setAttribute("aria-pressed","false"); }
    else{ document.documentElement.setAttribute("data-contrast","high"); contrastBtn.setAttribute("aria-pressed","true"); }
  });
  const soundBtn = document.getElementById("soundBtn");
  soundBtn.addEventListener("click", function(){
    state.soundOn = !state.soundOn;
    soundBtn.setAttribute("aria-pressed", String(state.soundOn));
    soundBtn.textContent = state.soundOn ? "🔊 Дыбыс" : "🔇 Дыбыс өшірулі";
  });

  const voiceSelectEl = document.getElementById("voiceSelect");
  if(voiceSelectEl){
    voiceSelectEl.addEventListener("change", function(){
      chosenVoiceName = voiceSelectEl.value || null;
      try{
        if(chosenVoiceName) localStorage.setItem("zerde_voice_v1", chosenVoiceName);
        else localStorage.removeItem("zerde_voice_v1");
      }catch(e){}
      speak("Дауыс таңдалды.");
    });
  }

  /* ================= Init ================= */
  buildGradeRow();
  updateBadges();
  selectTab("logic");
})();
</script>
</body>
</html>
