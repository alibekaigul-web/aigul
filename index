<!DOCTYPE html>
<html lang="kk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Зерде — логика, зейін және тыңдау жаттығулары</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F3F6F6;
    --bg-card:#FFFFFF;
    --bg-sunk:#E9EEEE;
    --ink:#20323A;
    --ink-soft:#5B6E76;
    --teal:#1F6F78;
    --teal-dark:#154F56;
    --teal-tint:#DDEBEC;
    --amber:#E3A857;
    --amber-tint:#FBEBD2;
    --coral:#E2665D;
    --green:#4C9A6A;
    --border:#DCE4E5;
    --radius-lg:22px;
    --radius-md:14px;
    --radius-sm:9px;
    --font-head:'Rubik', 'Inter', sans-serif;
    --font-body:'Inter', 'Rubik', sans-serif;
    --shadow: 0 1px 2px rgba(20,40,45,.06), 0 6px 20px rgba(20,40,45,.06);
    --scale:1;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#131B1D;
      --bg-card:#1B2528;
      --bg-sunk:#0F1618;
      --ink:#EAF1F1;
      --ink-soft:#9DB0B4;
      --teal:#4FB3BB;
      --teal-dark:#79CBD1;
      --teal-tint:#1E3438;
      --amber:#F0C285;
      --amber-tint:#3A2F1E;
      --coral:#F0938B;
      --green:#7FC79A;
      --border:#2B383C;
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"]{
    --bg:#131B1D; --bg-card:#1B2528; --bg-sunk:#0F1618; --ink:#EAF1F1; --ink-soft:#9DB0B4;
    --teal:#4FB3BB; --teal-dark:#79CBD1; --teal-tint:#1E3438; --amber:#F0C285; --amber-tint:#3A2F1E;
    --coral:#F0938B; --green:#7FC79A; --border:#2B383C;
    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);
    color-scheme: dark;
  }
  html[data-contrast="high"]{
    --bg:#000000; --bg-card:#0A0A0A; --bg-sunk:#050505; --ink:#FFFFFF; --ink-soft:#F2F2F2;
    --teal:#57D9E6; --teal-dark:#8DEBF3; --teal-tint:#04292D; --amber:#FFD166; --amber-tint:#332708;
    --coral:#FF8A80; --green:#8BE6A8; --border:#666666;
    --shadow: none;
    color-scheme: dark;
  }
  *{ box-sizing:border-box; }
  html{
    scroll-padding-top: env(safe-area-inset-top,0px);
    font-size: calc(16px * var(--scale));
  }
  body{
    margin:0;
    min-height:100%;
    background:var(--bg);
    color:var(--ink);
    font-family:var(--font-body);
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
    -webkit-font-smoothing:antialiased;
    transition: background .2s ease, color .2s ease;
  }
  h1,h2,h3,.brand,.tab,.grade-btn{ font-family:var(--font-head); }
  a{ color:var(--teal-dark); }
  button{ font-family:inherit; }
  :focus-visible{ outline:3px solid var(--amber); outline-offset:2px; border-radius:6px; }

  .wrap{ max-width:920px; margin:0 auto; padding:18px 18px 64px; }

  /* ---------- Header ---------- */
  header.top{
    position:sticky; top:env(safe-area-inset-top,0px); z-index:20;
    background:var(--bg);
    padding:14px 0 10px;
    border-bottom:1px solid var(--border);
  }
  .top-row{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
  .brand{ display:flex; align-items:center; gap:10px; }
  .brand .mark{
    width:40px; height:40px; border-radius:12px;
    background:linear-gradient(155deg, var(--teal) 0%, var(--teal-dark) 100%);
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-weight:700; font-size:1.1rem; flex-shrink:0;
  }
  .brand h1{ margin:0; font-size:1.35rem; font-weight:700; letter-spacing:-.01em; }
  .brand p{ margin:0; font-size:.8rem; color:var(--ink-soft); }

  .a11y-bar{ display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
  .a11y-btn{
    display:flex; align-items:center; gap:6px;
    background:var(--bg-card); border:1px solid var(--border); color:var(--ink);
    border-radius:999px; padding:7px 12px; font-size:.82rem; cursor:pointer;
    box-shadow:var(--shadow);
  }
  .a11y-btn[aria-pressed="true"]{ background:var(--teal); color:#fff; border-color:var(--teal); }
  .a11y-group{ display:flex; border:1px solid var(--border); border-radius:999px; overflow:hidden; background:var(--bg-card); box-shadow:var(--shadow); }
  .a11y-group button{ border:none; background:transparent; color:var(--ink); padding:7px 11px; cursor:pointer; font-size:.9rem; }
  .a11y-group button:hover{ background:var(--bg-sunk); }
  select.a11y-btn{ cursor:pointer; appearance:auto; }

  .ornament{
    height:8px; margin-top:12px;
    background-image: repeating-linear-gradient(135deg, var(--amber) 0 3px, transparent 3px 16px),
                       repeating-linear-gradient(45deg, var(--teal) 0 3px, transparent 3px 16px);
    background-position: 0 0, 8px 0;
    opacity:.55; border-radius:6px;
  }

  /* ---------- Category tabs ---------- */
  nav.tabs{ display:flex; gap:8px; margin:18px 0 14px; flex-wrap:wrap; }
  .tab{
    flex:1 1 160px; text-align:left; cursor:pointer; border:1px solid var(--border);
    background:var(--bg-card); border-radius:var(--radius-md); padding:12px 14px;
    display:flex; flex-direction:column; gap:2px; color:var(--ink);
    box-shadow:var(--shadow);
  }
  .tab strong{ font-size:1rem; }
  .tab span{ font-size:.78rem; color:var(--ink-soft); font-family:var(--font-body); }
  .tab[aria-selected="true"]{ border-color:var(--teal); background:var(--teal-tint); }
  .tab .count{ margin-top:6px; font-size:.75rem; color:var(--teal-dark); font-weight:600; }

  /* ---------- Grade stepper ---------- */
  .grade-panel{
    background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-lg);
    padding:14px 16px 16px; box-shadow:var(--shadow); margin-bottom:16px;
  }
  .grade-panel h2{ font-size:.85rem; margin:0 0 10px; color:var(--ink-soft); font-weight:600; text-transform:none; }
  .grade-row{ display:flex; align-items:center; gap:0; overflow-x:auto; padding-bottom:2px; }
  .grade-btn{
    flex:0 0 auto; width:38px; height:38px; border-radius:50%; border:2px solid var(--border);
    background:var(--bg-card); color:var(--ink); font-weight:600; cursor:pointer; position:relative; z-index:1;
  }
  .grade-btn[aria-current="true"]{ background:var(--amber); border-color:var(--amber); color:#3A2A0A; }
  .grade-line{ flex:1 1 auto; height:2px; background:var(--border); min-width:10px; }
  .grade-line.done{ background:var(--amber); }
  .tier-label{ margin-top:10px; font-size:.8rem; color:var(--ink-soft); }

  /* ---------- Task card ---------- */
  .task-card{
    background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-lg);
    padding:20px; box-shadow:var(--shadow); position:relative;
  }
  .task-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:10px; margin-bottom:6px;}
  .task-kind{ font-size:.72rem; letter-spacing:.02em; color:var(--teal-dark); font-weight:600; }
  .listen-btn{
    border:1px solid var(--border); background:var(--bg-sunk); color:var(--ink); border-radius:999px;
    padding:6px 12px; font-size:.8rem; cursor:pointer; display:flex; align-items:center; gap:6px; flex-shrink:0;
  }
  .listen-btn:hover{ background:var(--teal-tint); }
  .prompt{ font-size:1.08rem; line-height:1.5; margin:6px 0 16px; font-weight:500; }
  .task-body{ margin-bottom:14px; }
  .options{ display:flex; flex-wrap:wrap; gap:10px; }
  .opt-btn{
    border:2px solid var(--border); background:var(--bg-card); color:var(--ink);
    border-radius:var(--radius-md); padding:10px 16px; font-size:.95rem; cursor:pointer; min-width:64px;
  }
  .opt-btn:hover{ border-color:var(--teal); }
  .opt-btn.selected{ border-color:var(--teal); background:var(--teal-tint); }
  .opt-btn.correct{ border-color:var(--green); background:color-mix(in srgb, var(--green) 18%, var(--bg-card)); }
  .opt-btn.wrong{ border-color:var(--coral); background:color-mix(in srgb, var(--coral) 16%, var(--bg-card)); }
  .opt-btn:disabled{ cursor:default; opacity:.75; }

  .grid{ display:grid; gap:6px; margin-bottom:4px; }
  .cell{
    aspect-ratio:1; display:flex; align-items:center; justify-content:center; font-size:1.4rem;
    background:var(--bg-sunk); border-radius:var(--radius-sm); border:2px solid transparent; cursor:default; user-select:none;
  }
  .cell.tile{ cursor:pointer; background:var(--bg-card); border:2px solid var(--border); }
  .cell.tile:hover{ border-color:var(--teal); }
  .cell.flash{ background:var(--amber); }
  .cell.pickable{ cursor:pointer; }
  .cell.pickable:hover{ border-color:var(--teal); }
  .cell.correct{ border-color:var(--green); }
  .cell.wrong{ border-color:var(--coral); }

  .word-row{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:8px; }
  .transcript{
    background:var(--bg-sunk); border-radius:var(--radius-md); padding:10px 12px; font-size:.92rem;
    line-height:1.5; color:var(--ink-soft); margin-bottom:10px;
  }
  .toggle-text{ background:none; border:1px dashed var(--border); border-radius:999px; padding:5px 11px; font-size:.78rem; color:var(--ink-soft); cursor:pointer; margin-bottom:10px; }

  .task-actions{ display:flex; align-items:center; gap:10px; margin-top:16px; flex-wrap:wrap; }
  .btn{
    border:none; border-radius:999px; padding:11px 20px; font-size:.95rem; font-weight:600; cursor:pointer;
  }
  .btn-primary{ background:var(--teal); color:#fff; }
  .btn-primary:hover{ background:var(--teal-dark); }
  .btn-ghost{ background:transparent; color:var(--ink-soft); border:1px solid var(--border); }
  .btn-ghost:hover{ background:var(--bg-sunk); }
  .btn:disabled{ opacity:.5; cursor:default; }

  .feedback{ margin-top:14px; padding:10px 14px; border-radius:var(--radius-md); font-size:.94rem; display:none; }
  .feedback.show{ display:block; }
  .feedback.ok{ background:color-mix(in srgb, var(--green) 16%, var(--bg-card)); color:var(--green); }
  .feedback.no{ background:color-mix(in srgb, var(--coral) 14%, var(--bg-card)); color:var(--coral); }

  /* ---------- Progress footer ---------- */
  .progress-bar{
    display:flex; gap:10px; flex-wrap:wrap; margin-top:18px; align-items:center; justify-content:space-between;
  }
  .badges{ display:flex; gap:8px; flex-wrap:wrap; }
  .badge{
    background:var(--bg-card); border:1px solid var(--border); border-radius:999px; padding:6px 12px;
    font-size:.78rem; color:var(--ink-soft); box-shadow:var(--shadow);
  }
  .badge b{ color:var(--ink); }
  .reset-link{ background:none; border:none; color:var(--ink-soft); font-size:.78rem; text-decoration:underline; cursor:pointer; padding:4px; }

  ::-webkit-scrollbar{ height:6px; }

  @media (max-width:520px){
    .brand h1{ font-size:1.15rem; }
    .task-card{ padding:16px; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="top-row">
      <div class="brand">
        <div class="mark">З</div>
        <div>
          <h1>Зерде</h1>
          <p>1–9 сынып оқушыларына арналған логика, зейін және тыңдау жаттығулары</p>
        </div>
      </div>
      <div class="a11y-bar">
        <div class="a11y-group" role="group" aria-label="Қаріп өлшемі">
          <button id="fontDown" aria-label="Қаріпті кішірейту">A−</button>
          <button id="fontUp" aria-label="Қаріпті үлкейту">A+</button>
        </div>
        <button id="contrastBtn" class="a11y-btn" aria-pressed="false">◐ Жоғары контраст</button>
        <button id="soundBtn" class="a11y-btn" aria-pressed="true">🔊 Дыбыс</button>
        <select id="voiceSelect" class="a11y-btn" aria-label="Оқитын дауысты таңдау" style="max-width:180px;"></select>
      </div>
    </div>
    <div class="ornament" aria-hidden="true"></div>
  </header>

  <nav class="tabs" id="tabs" role="tablist" aria-label="Санат">
    <button class="tab" data-cat="logic" role="tab" aria-selected="false">
      <strong>🧩 Логика</strong>
      <span>Тізбек, ұқсастық, реттеу</span>
      <span class="count" id="count-logic"></span>
    </button>
    <button class="tab" data-cat="attention" role="tab" aria-selected="false">
      <strong>👁 Зейін</strong>
      <span>Байқампаздық, есте сақтау</span>
      <span class="count" id="count-attention"></span>
    </button>
    <button class="tab" data-cat="listening" role="tab" aria-selected="false">
      <strong>👂 Тыңдау</strong>
      <span>Дыбыс есту, тыңдап-түсіну</span>
      <span class="count" id="count-listening"></span>
    </button>
  </nav>

  <div class="grade-panel">
    <h2>Сынып</h2>
    <div class="grade-row" id="gradeRow"></div>
    <div class="tier-label" id="tierLabel"></div>
  </div>

  <main class="task-card" id="taskCard">
    <div class="task-top">
      <span class="task-kind" id="taskKind">—</span>
      <button class="listen-btn" id="listenBtn">🔊 Тыңда</button>
    </div>
    <p class="prompt" id="prompt">Санатты және сыныбыңды таңдап, бастаңыз.</p>
    <div class="task-body" id="taskBody"></div>
    <div class="task-actions">
      <button class="btn btn-primary" id="checkBtn">Тексеру</button>
      <button class="btn btn-ghost" id="nextBtn">Келесі тапсырма →</button>
    </div>
    <div class="feedback" id="feedback"></div>
  </main>

  <div class="progress-bar">
    <div class="badges" id="badges"></div>
    <button class="reset-link" id="resetBtn">Жетістікті тазарту</button>
  </div>
</div>

<script>
(function(){
  "use strict";

  /* ================= Utilities ================= */
  function randInt(min,max){ return Math.floor(Math.random()*(max-min+1))+min; }
  function pick(arr){ return arr[randInt(0,arr.length-1)]; }
  function shuffle(arr){ const a=arr.slice(); for(let i=a.length-1;i>0;i--){ const j=randInt(0,i); [a[i],a[j]]=[a[j],a[i]]; } return a; }
  function el(tag, props, kids){
    const e = document.createElement(tag);
    if(props) for(const k in props){
      if(k==="class") e.className=props[k];
      else if(k==="text") e.textContent=props[k];
      else if(k.startsWith("on")) e.addEventListener(k.slice(2), props[k]);
      else e.setAttribute(k, props[k]);
    }
    (kids||[]).forEach(k=> e.appendChild(k));
    return e;
  }
  function makeCell(content, cls, onClick){
    const c = el("div", { class: "cell " + (cls||""), text: content });
    if(onClick){
      c.classList.add("pickable");
      c.setAttribute("role","button");
      c.setAttribute("tabindex","0");
      c.addEventListener("click", onClick);
      c.addEventListener("keydown", function(ev){ if(ev.key==="Enter"||ev.key===" "){ ev.preventDefault(); onClick(); } });
    }
    return c;
  }

  /* ================= State ================= */
  const state = {
    category: "logic",
    grade: 1,
    task: null,        // current task descriptor from generator
    checked: false,
    soundOn: true,
  };

  const PROGRESS_KEY = "zerde_progress_v1";
  function loadProgress(){
    try{
      const raw = localStorage.getItem(PROGRESS_KEY);
      if(raw) return JSON.parse(raw);
    }catch(e){}
    return { logic:{correct:0,total:0}, attention:{correct:0,total:0}, listening:{correct:0,total:0} };
  }
  function saveProgress(p){
    try{ localStorage.setItem(PROGRESS_KEY, JSON.stringify(p)); }catch(e){}
  }
  let progress = loadProgress();

  function tierOf(grade){ return grade<=3 ? 1 : (grade<=6 ? 2 : 3); }

  /* ================= Speech (TTS) ================= */
  let chosenVoiceName = null;
  try{ chosenVoiceName = localStorage.getItem("zerde_voice_v1"); }catch(e){}

  function speak(text){
    if(!state.soundOn) return;
    try{
      if(!("speechSynthesis" in window)) return;
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      u.rate = 0.95;
      const voices = window.speechSynthesis.getVoices();
      let v = null;
      if(chosenVoiceName) v = voices.find(x=>x.name===chosenVoiceName);
      if(!v) v = voices.find(x=>x.lang && x.lang.toLowerCase().startsWith("kk"));
      if(!v) v = voices.find(x=>x.lang && x.lang.toLowerCase().startsWith("ru"));
      if(v){ u.voice = v; u.lang = v.lang; } else { u.lang = "kk-KZ"; }
      window.speechSynthesis.speak(u);
    }catch(e){}
  }

  function populateVoiceSelect(){
    const sel = document.getElementById("voiceSelect");
    if(!sel || !("speechSynthesis" in window)) return;
    const voices = window.speechSynthesis.getVoices();
    if(!voices.length) return;
    const prevValue = sel.value;
    sel.innerHTML = "";
    sel.appendChild(el("option",{value:"", text:"Автоматты дауыс"}));
    voices.forEach(v=>{
      const label = v.name + " (" + v.lang + ")";
      sel.appendChild(el("option",{value:v.name, text:label}));
    });
    if(chosenVoiceName && voices.some(v=>v.name===chosenVoiceName)){
      sel.value = chosenVoiceName;
    } else if(prevValue){
      sel.value = prevValue;
    }
  }
  if("speechSynthesis" in window){
    window.speechSynthesis.onvoiceschanged = populateVoiceSelect;
    populateVoiceSelect();
  }

  /* ================= Beep audio ================= */
  let actx = null;
  function beep(freq, dur){
    return new Promise(function(resolve){
      if(!state.soundOn){ resolve(); return; }
      try{
        if(!actx) actx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = actx.createOscillator();
        const gain = actx.createGain();
        osc.frequency.value = freq;
        osc.type = "sine";
        gain.gain.setValueAtTime(0.0001, actx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.25, actx.currentTime+0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime+dur/1000);
        osc.connect(gain); gain.connect(actx.destination);
        osc.start();
        osc.stop(actx.currentTime + dur/1000 + 0.02);
        setTimeout(resolve, dur);
      }catch(e){ resolve(); }
    });
  }
  async function playBeepSequence(count, gap){
    for(let i=0;i<count;i++){
      await beep(520, 220);
      await new Promise(r=>setTimeout(r, gap));
    }
  }

  /* ================= Content banks ================= */
  const COLORS = [
    {word:"Қызыл", hex:"#E2665D"},
    {word:"Көк",   hex:"#2F6FA6"},
    {word:"Жасыл", hex:"#4C9A6A"},
    {word:"Сары",  hex:"#D9A441"},
  ];

  const ANALOGIES = {
    1:[
      {a:"Ит",b:"Үреді",c:"Мысық", options:["Мияулайды","Ұшады","Жүзеді","Секіреді"], correct:"Мияулайды"},
      {a:"Күн",b:"Ыстық",c:"Мұз", options:["Суық","Жұмсақ","Дөңгелек","Ащы"], correct:"Суық"},
      {a:"Құс",b:"Ұя",c:"Аю", options:["Үңгір","Аквариум","Клетка","Су"], correct:"Үңгір"},
    ],
    2:[
      {a:"Қол",b:"Саусақ",c:"Аяқ", options:["Башпай","Тізе","Тобық","Өкше"], correct:"Башпай"},
      {a:"Мектеп",b:"Мұғалім",c:"Ауруxана", options:["Дәрігер","Дастарқан","Жол","Кітап"], correct:"Дәрігер"},
      {a:"Кітап",b:"Оқу",c:"Ән", options:["Шырқау","Жүгіру","Жазу","Ұйықтау"], correct:"Шырқау"},
    ],
    3:[
      {a:"2",b:"4",c:"3", options:["5","6","9","7"], correct:"6"},
      {a:"Ыстық",b:"Салқындату",c:"Лас", options:["Тазарту","Бояу","Кесу","Жабу"], correct:"Тазарту"},
      {a:"Себеп",b:"Салдар: Жаңбыр",c:"Себеп: Жаңбыр", options:["Су тасқыны","Күн","Жел","Қар"], correct:"Су тасқыны"},
    ],
  };

  const ODD_ONE_OUT = {
    1:[
      {items:["🍎","🍎","🍎","🚗"], oddIndex:3},
      {items:["🔵","🔵","🔴","🔵"], oddIndex:2},
      {items:["🐶","🐶","🐱","🐶"], oddIndex:2},
    ],
    2:[
      {items:["Ит","Мысық","Аю","Алма"], oddIndex:3},
      {items:["Дөңгелек","Шаршы","Үшбұрыш","Қызыл"], oddIndex:3},
      {items:["2","4","6","7"], oddIndex:3},
    ],
    3:[
      {items:["3","5","9","2"], oddIndex:3},
